    function validVaultProfileHotfixV2(uid) {
      let action = request.resource.data.get("lastAction", {});
      let itemId = action.get("key", "");
      let beforeUnlocked = resource.data.get("unlocked", []);
      let afterUnlocked = request.resource.data.get("unlocked", []);
      let price = resource.data.get("coin", 0) - request.resource.data.get("coin", 0);
      let ledgerPath = /databases/$(database)/documents/progressionLedger/$("spend_" + uid + "_" + itemId);
      return isApprovedMember()
        && request.auth.uid == uid
        && action is map
        && action.get("type", "") == "vault_unlock"
        && requiredText(itemId, 80)
        && beforeUnlocked is list
        && afterUnlocked is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["coin", "unlocked", "lastAction", "updatedAt"])
        && request.resource.data.updatedAt == request.time
        && validVaultTermsV3(itemId, price, resource.data.get("xp", 0))
        && request.resource.data.get("coin", -1) >= 0
        && afterUnlocked.size() == beforeUnlocked.size() + 1
        && afterUnlocked.toSet().difference(beforeUnlocked.toSet()).hasOnly([itemId])
        && afterUnlocked.toSet().difference(beforeUnlocked.toSet()).hasAny([itemId])
        && existsAfter(ledgerPath)
        && getAfter(ledgerPath).data.uid == uid
        && getAfter(ledgerPath).data.sourceType == "vault_spend"
        && getAfter(ledgerPath).data.sourceKey == itemId
        && getAfter(ledgerPath).data.itemId == itemId
        && getAfter(ledgerPath).data.xp == 0
        && getAfter(ledgerPath).data.coin == 0 - price
        && getAfter(ledgerPath).data.balanceAfter == request.resource.data.get("coin", -1)
        && getAfter(ledgerPath).data.createdAt == request.time;
    }

    function validCosmeticUnlockSocialHotfixV1(eventId) {
      let uid = request.auth.uid;
      let itemId = request.resource.data.get("itemId", "");
      let profilePath = /databases/$(database)/documents/progressionProfiles/$(uid);
      let ledgerPath = /databases/$(database)/documents/progressionLedger/$("spend_" + uid + "_" + itemId);
      let profile = getAfter(profilePath).data;
      let action = profile.get("lastAction", {});
      return isApprovedMember()
        && request.resource.data.keys().hasOnly(["uid", "nickname", "type", "itemId", "title", "detail", "targetUrl", "reactions", "createdAt"])
        && request.resource.data.uid == uid
        && requiredText(request.resource.data.nickname, 60)
        && request.resource.data.type == "cosmetic_unlock"
        && requiredText(itemId, 80)
        && eventId == uid + "_cosmetic_" + itemId
        && requiredText(request.resource.data.title, 120)
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 240
        && requiredText(request.resource.data.targetUrl, 160)
        && request.resource.data.targetUrl.matches("^/.*")
        && request.resource.data.reactions == 0
        && request.resource.data.createdAt == request.time
        && existsAfter(profilePath)
        && profile.updatedAt == request.time
        && action is map
        && action.get("type", "") == "vault_unlock"
        && action.get("key", "") == itemId
        && profile.unlocked.toSet().hasAny([itemId])
        && existsAfter(ledgerPath)
        && getAfter(ledgerPath).data.uid == uid
        && getAfter(ledgerPath).data.sourceType == "vault_spend"
        && getAfter(ledgerPath).data.sourceKey == itemId
        && getAfter(ledgerPath).data.itemId == itemId
        && getAfter(ledgerPath).data.balanceAfter == profile.coin
        && getAfter(ledgerPath).data.createdAt == request.time;
    }

    match /progressionProfiles/{uid} {
      allow update: if validVaultProfileHotfixV2(uid);
    }

    match /socialEvents/{eventId} {
      allow create: if validCosmeticUnlockSocialHotfixV1(eventId);
    }
