rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // ADMIN AUTHORIZATION
    // =========================================================
    // The current admin.html authenticates this address.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "erkaa130@gmail.com"
        && request.auth.token.firebase.sign_in_provider == "password";
    }

    function isApprovedMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/memberAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberAccounts/$(request.auth.uid)).data.status == "approved";
    }

    function isNumber(v) {
      return v is int || v is float;
    }

    function hasOnlyKeys(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function hasAllKeys(data, required) {
      return data.keys().hasAll(required);
    }

    function requiredText(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function optionalText(data, key, maxLen) {
      return !data.keys().hasAny([key])
        || (data[key] is string && data[key].size() <= maxLen);
    }

    function optionalTimestamp(data, key) {
      return !data.keys().hasAny([key]) || data[key] is timestamp;
    }

    function optionalDateLike(data, key) {
      return !data.keys().hasAny([key])
        || data[key] is timestamp
        || data[key] is string
        || data[key] is int;
    }

    // =========================================================
    // MEMBERS
    // =========================================================
    match /members/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // CREW MEMBER ACCOUNTS
    // =========================================================
    match /memberAccounts/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && hasOnlyKeys(request.resource.data, [
          "email", "memberId", "nickname", "cpmId", "status", "createdAt", "updatedAt"
        ])
        && hasAllKeys(request.resource.data, [
          "email", "memberId", "nickname", "cpmId", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && requiredText(request.resource.data.memberId, 80)
        && requiredText(request.resource.data.nickname, 60)
        && requiredText(request.resource.data.cpmId, 60)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/members/$(request.resource.data.memberId))
        && (
          get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.get("nick", "") == request.resource.data.nickname
          || get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.get("nickname", "") == request.resource.data.nickname
          || get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.get("name", "") == request.resource.data.nickname
        )
        && (
          get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.get("cpmid", "") == request.resource.data.cpmId
          || get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.get("cpmId", "") == request.resource.data.cpmId
        );
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // GARAGE
    // =========================================================
    match /garage/{garageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // APPLICATIONS / JOIN
    // =========================================================
    match /applications/{applicationId} {
      allow create: if
        hasOnlyKeys(request.resource.data, [
          "last", "first", "age", "gender", "cpmid", "nick", "direction",
          "contactType", "contact", "experience", "message", "status", "createdAt"
        ])
        && hasAllKeys(request.resource.data, [
          "last", "first", "age", "gender", "cpmid", "nick", "direction",
          "contactType", "contact", "experience", "message", "status"
        ])
        && request.resource.data.status == "Шинэ"
        && requiredText(request.resource.data.last, 80)
        && requiredText(request.resource.data.first, 80)
        && request.resource.data.age is int
        && request.resource.data.age >= 17
        && request.resource.data.age <= 90
        && request.resource.data.gender in ["Эрэгтэй", "Эмэгтэй"]
        && requiredText(request.resource.data.cpmid, 60)
        && requiredText(request.resource.data.nick, 60)
        && request.resource.data.direction in [
          "Clean Car", "Anime Car", "Racer / Drifter", "Drag Racer", "Content Creator", "Other"
        ]
        && request.resource.data.contactType in ["Instagram", "Discord", "Phone"]
        && requiredText(request.resource.data.contact, 120)
        && request.resource.data.experience in [
          "6 сараас бага", "6 сар – 1 жил", "1 – 2 жил", "2 жилээс дээш"
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1500
        && optionalTimestamp(request.resource.data, "createdAt");

      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // PRODUCTS / MARKET
    // =========================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // GALLERY
    // =========================================================
    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // ORDERS
    // =========================================================
    match /orders/{orderId} {
      allow create: if
        hasOnlyKeys(request.resource.data, [
          "orderNo", "productId", "productName", "unitPrice", "quantity", "total",
          "cpmNick", "cpmId", "instagram", "phone", "note", "status", "createdAt"
        ])
        && hasAllKeys(request.resource.data, [
          "orderNo", "productId", "productName", "unitPrice", "quantity", "total",
          "cpmNick", "cpmId", "status"
        ])
        && request.resource.data.status == "Шинэ"
        && requiredText(request.resource.data.orderNo, 40)
        && requiredText(request.resource.data.productId, 120)
        && requiredText(request.resource.data.productName, 180)
        && isNumber(request.resource.data.unitPrice)
        && request.resource.data.unitPrice >= 0
        && request.resource.data.unitPrice <= 1000000000
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 99
        && isNumber(request.resource.data.total)
        && request.resource.data.total >= 0
        && request.resource.data.total <= 1000000000
        && requiredText(request.resource.data.cpmNick, 60)
        && requiredText(request.resource.data.cpmId, 60)
        && optionalText(request.resource.data, "instagram", 120)
        && optionalText(request.resource.data, "phone", 40)
        && optionalText(request.resource.data, "note", 800)
        && optionalTimestamp(request.resource.data, "createdAt");

      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // SITE
    // =========================================================
    match /site/{siteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // SETTINGS
    // =========================================================
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // MUSIC
    // =========================================================
    match /music/{musicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // ONI MEET
    // =========================================================
    match /meets/{meetId} {
      // Public website needs the current meet for countdown/room access.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // ONI MEET PARTICIPANTS
    // =========================================================
    // The website only accepts a participant whose memberId exists in the
    // public roster and whose Nick + CPM ID match that roster document.
    // This prevents arbitrary fake participant records while keeping the
    // realtime public counter working without requiring user login.
    function validParticipantBase(participantId) {
      let data = request.resource.data;
      let memberPath = /databases/$(database)/documents/members/$(data.memberId);
      let member = get(memberPath).data;
      let accountPath = /databases/$(database)/documents/memberAccounts/$(request.auth.uid);
      return request.auth != null
        && participantId == request.auth.uid
        && exists(accountPath)
        && get(accountPath).data.status == "approved"
        && get(accountPath).data.memberId == data.memberId
        && get(accountPath).data.nickname == data.nick
        && get(accountPath).data.cpmId == data.cpmId
        && request.resource.data.meetId == "current"
        && hasOnlyKeys(data, [
          "meetId", "meetStartAt", "memberId", "nick", "name", "cpmId", "joinedAt", "source", "slotId"
        ])
        && hasAllKeys(data, ["meetId", "memberId", "nick", "name", "cpmId", "source", "slotId"])
        && requiredText(data.slotId, 20)
        && requiredText(data.memberId, 80)
        && requiredText(data.nick, 60)
        && requiredText(data.name, 60)
        && requiredText(data.cpmId, 60)
        && data.source == "website"
        && optionalTimestamp(data, "joinedAt")
        && optionalDateLike(data, "meetStartAt")
        && exists(/databases/$(database)/documents/meets/current)
        && get(/databases/$(database)/documents/meets/current).data.enabled == true
        && exists(memberPath)
        && existsAfter(/databases/$(database)/documents/meetSlots/$(data.slotId))
        && getAfter(/databases/$(database)/documents/meetSlots/$(data.slotId)).data.participantId == participantId
        && (
          member.get("nick", "") == data.nick
          || member.get("nickname", "") == data.nick
          || member.get("name", "") == data.nick
        )
        && (
          member.get("cpmid", "") == data.cpmId
          || member.get("cpmId", "") == data.cpmId
        )
        && member.get("status", "active") != "inactive"
        && member.get("status", "active") != "archived";
    }

    match /meetParticipants/{participantId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == participantId);

      // Initial JOIN and later CPM-opened timestamp update.
      allow create: if validParticipantBase(participantId);

      allow update: if validParticipantBase(participantId)
        && resource.data.memberId == request.resource.data.memberId
        && resource.data.meetId == request.resource.data.meetId
        && resource.data.source == request.resource.data.source
        && resource.data.nick == request.resource.data.nick
        && resource.data.name == request.resource.data.name
        && resource.data.cpmId == request.resource.data.cpmId;

      allow delete: if isAdmin();
    }

    // Public nickname-only roster. CPM IDs stay in the private participant document.
    match /meetRoster/{participantId} {
      allow read: if true;
      allow create: if isApprovedMember()
        && request.auth.uid == participantId
        && hasOnlyKeys(request.resource.data, ["meetId", "nickname", "joinedAt"])
        && hasAllKeys(request.resource.data, ["meetId", "nickname", "joinedAt"])
        && request.resource.data.meetId == "current"
        && request.resource.data.joinedAt is timestamp
        && existsAfter(/databases/$(database)/documents/meetParticipants/$(participantId))
        && getAfter(/databases/$(database)/documents/meetParticipants/$(participantId)).data.nick
          == request.resource.data.nickname;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // =========================================================
    // ONI MEET CAPACITY SLOTS
    // =========================================================
    match /meetSlots/{slotId} {
      allow read: if isAdmin() || isApprovedMember();
      allow create: if
        slotId.matches("^current_[0-9]{2}$")
        && hasOnlyKeys(request.resource.data, [
          "meetId", "participantId", "memberId", "createdAt"
        ])
        && hasAllKeys(request.resource.data, [
          "meetId", "participantId", "memberId", "createdAt"
        ])
        && request.resource.data.meetId == "current"
        && requiredText(request.resource.data.participantId, 120)
        && requiredText(request.resource.data.memberId, 80)
        && request.resource.data.createdAt is timestamp
        && existsAfter(
          /databases/$(database)/documents/meetParticipants/$(request.resource.data.participantId)
        )
        && getAfter(
          /databases/$(database)/documents/meetParticipants/$(request.resource.data.participantId)
        ).data.slotId == slotId
        && getAfter(
          /databases/$(database)/documents/meetParticipants/$(request.resource.data.participantId)
        ).data.memberId == request.resource.data.memberId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Room ID and password must never be readable publicly.
    match /meetCredentials/{meetId} {
      allow read: if isAdmin()
        || (
          meetId == "current"
          && isApprovedMember()
          && exists(/databases/$(database)/documents/meetParticipants/$(request.auth.uid))
          && get(/databases/$(database)/documents/meetParticipants/$(request.auth.uid)).data.memberId
            == get(/databases/$(database)/documents/memberAccounts/$(request.auth.uid)).data.memberId
        );
      allow create, update, delete: if isAdmin();
    }

    // Completed meet history is public, but only admins can archive it.
    match /meetResults/{resultId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // ADMIN AUDIT LOG — append only
    // =========================================================
    match /auditLogs/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && hasOnlyKeys(request.resource.data, [
          "actorId", "actorRole", "action", "target", "severity", "result", "detail", "createdAt"
        ])
        && hasAllKeys(request.resource.data, [
          "actorId", "actorRole", "action", "severity", "result", "createdAt"
        ])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole in ["owner", "admin", "moderator"]
        && requiredText(request.resource.data.action, 120)
        && request.resource.data.severity in ["info", "warning", "critical"]
        && request.resource.data.result in ["success", "failure", "denied"]
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // =========================================================
    // EVERYTHING ELSE = DENY
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
