rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // ADMIN AUTHORIZATION
    // =========================================================
    // The current admin.html authenticates this address.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "erkaa130@gmail.com"
        && request.auth.token.firebase.sign_in_provider == "password";
    }

    function isNumber(v) {
      return v is int || v is float;
    }

    function hasOnlyKeys(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function hasAllKeys(data, required) {
      return data.keys().hasAll(required);
    }

    function requiredText(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function optionalText(data, key, maxLen) {
      return !data.keys().hasAny([key])
        || (data[key] is string && data[key].size() <= maxLen);
    }

    function optionalTimestamp(data, key) {
      return !data.keys().hasAny([key]) || data[key] is timestamp;
    }

    function optionalDateLike(data, key) {
      return !data.keys().hasAny([key])
        || data[key] is timestamp
        || data[key] is string
        || data[key] is int;
    }

    // =========================================================
    // MEMBERS
    // =========================================================
    match /members/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // GARAGE
    // =========================================================
    match /garage/{garageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // APPLICATIONS / JOIN
    // =========================================================
    match /applications/{applicationId} {
      allow create: if
        hasOnlyKeys(request.resource.data, [
          "last", "first", "age", "gender", "cpmid", "nick", "direction",
          "contactType", "contact", "experience", "message", "status", "createdAt"
        ])
        && hasAllKeys(request.resource.data, [
          "last", "first", "age", "gender", "cpmid", "nick", "direction",
          "contactType", "contact", "experience", "message", "status"
        ])
        && request.resource.data.status == "Шинэ"
        && requiredText(request.resource.data.last, 80)
        && requiredText(request.resource.data.first, 80)
        && request.resource.data.age is int
        && request.resource.data.age >= 17
        && request.resource.data.age <= 90
        && request.resource.data.gender in ["Эрэгтэй", "Эмэгтэй"]
        && requiredText(request.resource.data.cpmid, 60)
        && requiredText(request.resource.data.nick, 60)
        && request.resource.data.direction in [
          "Clean Car", "Anime Car", "Racer / Drifter", "Drag Racer", "Content Creator", "Other"
        ]
        && request.resource.data.contactType in ["Instagram", "Discord", "Phone"]
        && requiredText(request.resource.data.contact, 120)
        && request.resource.data.experience in [
          "6 сараас бага", "6 сар – 1 жил", "1 – 2 жил", "2 жилээс дээш"
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1500
        && optionalTimestamp(request.resource.data, "createdAt");

      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // PRODUCTS / MARKET
    // =========================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // GALLERY
    // =========================================================
    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // ORDERS
    // =========================================================
    match /orders/{orderId} {
      allow create: if
        hasOnlyKeys(request.resource.data, [
          "orderNo", "productId", "productName", "unitPrice", "quantity", "total",
          "cpmNick", "cpmId", "instagram", "phone", "note", "status", "createdAt"
        ])
        && hasAllKeys(request.resource.data, [
          "orderNo", "productId", "productName", "unitPrice", "quantity", "total",
          "cpmNick", "cpmId", "status"
        ])
        && request.resource.data.status == "Шинэ"
        && requiredText(request.resource.data.orderNo, 40)
        && requiredText(request.resource.data.productId, 120)
        && requiredText(request.resource.data.productName, 180)
        && isNumber(request.resource.data.unitPrice)
        && request.resource.data.unitPrice >= 0
        && request.resource.data.unitPrice <= 1000000000
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 99
        && isNumber(request.resource.data.total)
        && request.resource.data.total >= 0
        && request.resource.data.total <= 1000000000
        && requiredText(request.resource.data.cpmNick, 60)
        && requiredText(request.resource.data.cpmId, 60)
        && optionalText(request.resource.data, "instagram", 120)
        && optionalText(request.resource.data, "phone", 40)
        && optionalText(request.resource.data, "note", 800)
        && optionalTimestamp(request.resource.data, "createdAt");

      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // SITE
    // =========================================================
    match /site/{siteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // SETTINGS
    // =========================================================
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // MUSIC
    // =========================================================
    match /music/{musicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // ONI MEET
    // =========================================================
    match /meets/{meetId} {
      // Public website needs the current meet for countdown/room access.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // ONI MEET PARTICIPANTS
    // =========================================================
    // The website only accepts a participant whose memberId exists in the
    // public roster and whose Nick + CPM ID match that roster document.
    // This prevents arbitrary fake participant records while keeping the
    // realtime public counter working without requiring user login.
    function validParticipantBase() {
      let data = request.resource.data;
      let memberPath = /databases/$(database)/documents/members/$(data.memberId);
      let member = get(memberPath).data;
      return request.resource.data.meetId == "current"
        && hasOnlyKeys(data, [
          "meetId", "meetStartAt", "memberId", "nick", "name", "cpmId", "joinedAt", "source"
        ])
        && hasAllKeys(data, ["meetId", "memberId", "nick", "name", "cpmId", "source"])
        && requiredText(data.memberId, 80)
        && requiredText(data.nick, 60)
        && requiredText(data.name, 60)
        && requiredText(data.cpmId, 60)
        && data.source == "website"
        && optionalTimestamp(data, "joinedAt")
        && optionalDateLike(data, "meetStartAt")
        && exists(/databases/$(database)/documents/meets/current)
        && get(/databases/$(database)/documents/meets/current).data.enabled == true
        && exists(memberPath)
        && (member.nick == data.nick || member.nickname == data.nick || member.name == data.nick)
        && (member.cpmid == data.cpmId || member.cpmId == data.cpmId);
    }

    match /meetParticipants/{participantId} {
      allow read: if true;

      // Initial JOIN and later CPM-opened timestamp update.
      allow create: if validParticipantBase();

      allow update: if validParticipantBase()
        && resource.data.memberId == request.resource.data.memberId
        && resource.data.meetId == request.resource.data.meetId
        && resource.data.source == request.resource.data.source
        && resource.data.nick == request.resource.data.nick
        && resource.data.name == request.resource.data.name
        && resource.data.cpmId == request.resource.data.cpmId;

      allow delete: if isAdmin();
    }

    // =========================================================
    // EVERYTHING ELSE = DENY
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
