rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "erkaa130@gmail.com";
    }

    match /members/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /garage/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /applications/{id} { allow create: if request.resource.data.status == "Шинэ"; allow read, update, delete: if isAdmin(); }
    match /products/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /gallery/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /orders/{id} { allow create: if request.resource.data.status == "Шинэ"; allow read, update, delete: if isAdmin(); }
    match /site/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }

    // ONI Meet: public can see the current meet; only admin can configure it.
    match /meets/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    // Participant records are intentionally public for realtime roster display.
    // The website performs member-roster verification before writing.
    match /meetParticipants/{id} { allow read: if true; allow create, update: if true; allow delete: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
